# ==============================================================
# پیکربندی متغیرهای محیطی امنیتی سرور Gemini Shop Backend
# فایل اصلی را تحت عنوان .env در پوشه server قرار دهید.
# هرگز فایل .env حاوی مقادیر واقعی را در گیت کامیت نکنید!
# ==============================================================

# پورت اجرای وب سرور Node.js
PORT=3001
NODE_ENV=production

# آدرس فایل ذخیره‌سازی داده‌های دیتابیس (در محیط‌های ابری مانند Render دیسک پایدار متصل شود)
DATA_FILE=./gemini_store_data.json

# رمز عبور اولیه مدیر ارشد (برای اولین راه‌اندازی سرور)
# این رمز به صورت خودکار با سالت تصادفی و ۱۰۰ هزار دور PBKDF2 هش می‌شود
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# دامنه‌های مجاز برای CORS (با کاما جدا شوند). در محیط پروداکشن دامنه کلادفلر خود را وارد کنید:
# مثال: https://gemini-shop.pages.dev,https://yourdomain.com
ALLOWED_ORIGINS=*

# تنظیمات ارسال ایمیل زنده کد یکبارمصرف OTP با Gmail
# ۱. فعال‌سازی تایید دو مرحله‌ای (2-Step Verification) در حساب گوگل
# ۲. دریافت رمز عبور برنامه ۱۶ رقمی (App Password) از آدرس: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_store_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
